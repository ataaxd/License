# Terisi otomatis setelah menghubungkan integrasi "Upstash for Redis" dari Vercel Marketplace
# (Dashboard project -> Storage -> cari/connect "Upstash" -> buat database -> Connect)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Kunci rahasia untuk panel admin & endpoint admin (generate/revoke/renew/list)
# Buat string acak panjang, JANGAN pernah dipakai di kode sisi client, jangan di-commit ke git
ADMIN_API_KEY=ganti-dengan-string-rahasia-panjang
